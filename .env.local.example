# Copy to .env.local and fill in what you want to enable.

# Voice/agent routes.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=

# Google Calendar. Used by /api/calendar and Kai's next-session planner.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Gmail history/search/draft access. If omitted, Kai falls back to the calendar OAuth envs.
# The refresh token needs Gmail scopes for history/drafts, e.g.
# https://www.googleapis.com/auth/gmail.readonly and https://www.googleapis.com/auth/gmail.compose
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REFRESH_TOKEN=

# Live web search. Kai uses the first configured provider, in this order:
# Brave, Tavily, Serper, Google Custom Search. Without a key it falls back to
# DuckDuckGo Instant Answer, which is useful but not a full web search index.
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Spotify voice controls.
# Recommended Spotify scopes:
# user-read-playback-state user-modify-playback-state user-read-currently-playing
# user-library-read playlist-read-private playlist-read-collaborative
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Public canonical URL used by metadata, sitemap, robots, and social previews.
NEXT_PUBLIC_SITE_URL=https://heykai.vercel.app

# Alexa custom skill endpoint.
ALEXA_SKILL_ID=
ALEXA_VERIFY_SIGNATURES=false

# Unlocks the connected-account routes (calendar, email, Spotify, Alexa command
# queue) for the deployment owner. Set this in production and paste the same
# value into Customize > Connected accounts in your own browser. When unset,
# those routes are open in local dev and closed in production.
KAI_OWNER_TOKEN=
